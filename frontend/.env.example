# ============================================================
# Copy to .env and fill in after running the deploy script:
#   forge script scripts/Deploy.s.sol --rpc-url <RPC_URL> --broadcast
#   forge script scripts/SeedDemo.s.sol --rpc-url <RPC_URL> --broadcast
# ============================================================

# Chain / RPC
VITE_RPC_URL=http://127.0.0.1:8545
VITE_COSMOS_RPC_URL=http://127.0.0.1:26657
VITE_COSMOS_REST_URL=http://127.0.0.1:1317
VITE_EVM_CHAIN_ID=31337
VITE_CHAIN_ID=appswap-1
VITE_CHAIN_NAME=AppSwap

# Core contracts (output of Deploy.s.sol)
VITE_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_POOL_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_FEE_DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000

# Token addresses (output of SeedDemo.s.sol)
# Stablecoins
VITE_TOKEN_USDC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_USDT_ADDRESS=0x0000000000000000000000000000000000000000

# Initia native
VITE_TOKEN_INIT_ADDRESS=0x0000000000000000000000000000000000000000

# Wrapped major assets
VITE_TOKEN_WBTC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_ETH_ADDRESS=0x0000000000000000000000000000000000000000

# IBC-bridged Cosmos ecosystem
VITE_TOKEN_TIA_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_ATOM_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_INJ_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_OSMO_ADDRESS=0x0000000000000000000000000000000000000000
